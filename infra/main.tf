# FitCheck on AWS: one Lambda function (container image) with a public streaming URL,
# a schedule that keeps the index in step with GitHub, secrets in SSM, logs in CloudWatch.
# No VPC on purpose: the function only calls public APIs (NVIDIA, GitHub, OpenRouter, Neon),
# and a VPC would need a NAT gateway for that (~$30+ a month even when idle).

# ---------------------------------------------------------------- image

resource "aws_ecr_repository" "app" {
  name                 = var.name
  image_tag_mutability = "MUTABLE" # "latest" moves; deploys pin the commit tag
  force_delete         = true

  image_scanning_configuration {
    scan_on_push = true
  }
}

# Keep the last 3 images; ECR storage is billed per GB.
resource "aws_ecr_lifecycle_policy" "app" {
  repository = aws_ecr_repository.app.name
  policy = jsonencode({
    rules = [{
      rulePriority = 1
      description  = "keep the last 3 images"
      selection    = { tagStatus = "any", countType = "imageCountMoreThan", countNumber = 3 }
      action       = { type = "expire" }
    }]
  })
}

# ---------------------------------------------------------------- secrets

# You fill these in yourself (infra/README.md); Terraform only creates placeholders and
# never sees the values. "set-me" is skipped by the app.
resource "aws_ssm_parameter" "secret" {
  for_each = {
    nvidia_api_key     = "NVIDIA API key: chat, JD parsing and embeddings"
    database_url       = "Postgres + pgvector URL (Neon: the direct URL, not the pooler)"
    openrouter_api_key = "OpenRouter key, only for scorer = system_one (leave set-me otherwise)"
    github_token       = "Optional GitHub token: raises the API limit from 60 to 5000 requests/hour"
  }
  name        = "${local.ssm_prefix}/${each.key}"
  description = each.value
  type        = "SecureString"
  value       = "set-me"

  lifecycle {
    ignore_changes = [value]
  }
}

# The schedule's sync events and POST /api/sync must carry this token, because /events is
# reachable through the public URL too. Generated here; also salts the rate-limit IP hashes.
resource "random_password" "sync_token" {
  length  = 40
  special = false
}

resource "aws_ssm_parameter" "sync_token" {
  name        = "${local.ssm_prefix}/sync_token"
  description = "Token for sync events and POST /api/sync (generated by Terraform)"
  type        = "SecureString"
  value       = random_password.sync_token.result
}

# ---------------------------------------------------------------- function

data "aws_iam_policy_document" "lambda_trust" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "fn" {
  name               = var.name
  assume_role_policy = data.aws_iam_policy_document.lambda_trust.json
}

resource "aws_iam_role_policy_attachment" "logs" {
  role       = aws_iam_role.fn.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

# Its own secrets, nothing else.
data "aws_iam_policy_document" "fn" {
  statement {
    sid       = "ReadOwnSecrets"
    actions   = ["ssm:GetParametersByPath", "ssm:GetParameter", "ssm:GetParameters"]
    resources = ["arn:aws:ssm:${local.region}:${local.account}:parameter${local.ssm_prefix}", "arn:aws:ssm:${local.region}:${local.account}:parameter${local.ssm_prefix}/*"]
  }
}

resource "aws_iam_role_policy" "fn" {
  name   = "read-secrets"
  role   = aws_iam_role.fn.id
  policy = data.aws_iam_policy_document.fn.json
}

resource "aws_cloudwatch_log_group" "fn" {
  name              = "/aws/lambda/${local.fn_name}"
  retention_in_days = var.log_retention_days
}

# Created once the image exists (var.create_function). After that GitHub Actions deploys new
# code with `aws lambda update-function-code`, so Terraform ignores image_uri.
resource "aws_lambda_function" "app" {
  count         = local.fn
  function_name = local.fn_name
  description   = "FitCheck: evidence-grounded job fit (FastAPI behind the Lambda Web Adapter)"
  role          = aws_iam_role.fn.arn
  package_type  = "Image"
  image_uri     = "${aws_ecr_repository.app.repository_url}:latest"
  architectures = ["x86_64"]
  memory_size   = var.memory_mb
  timeout       = 300 # a check takes ~10-20 s; a sync that re-embeds a big repo can take minutes

  environment {
    variables = {
      SSM_PREFIX               = local.ssm_prefix
      RUNTIME                  = "lambda"
      PROVIDER_MODE            = "live"
      VECTOR_STORE             = "pgvector"
      DB_POOL_MIN              = "0" # a frozen function holds no idle connections
      RATE_LIMIT_STORE         = "postgres"
      RATE_LIMIT_PER_HOUR      = tostring(var.rate_limit_per_hour)
      DAILY_LIMIT              = tostring(var.daily_limit)
      SCORER                   = var.scorer
      GITHUB_USER              = var.github_user
      GITHUB_BASE_URL          = "https://github.com/${var.github_user}"
      GITHUB_SYNC_INTERVAL_MIN = tostring(var.sync_minutes)
      CANDIDATE_NAME           = var.candidate_name
    }
  }

  depends_on = [aws_cloudwatch_log_group.fn, aws_iam_role_policy_attachment.logs]
  lifecycle {
    ignore_changes = [image_uri]
  }
}

resource "aws_lambda_function_url" "app" {
  count              = local.fn
  function_name      = aws_lambda_function.app[0].function_name
  authorization_type = "NONE"
  invoke_mode        = "RESPONSE_STREAM" # the step-by-step report is Server-Sent Events
}

# A function URL with auth NONE still needs a resource policy that lets anyone call it
# through the URL (and, for URLs created since October 2025, InvokeFunction too, limited to
# calls that come through the URL).
resource "aws_lambda_permission" "url" {
  count                  = local.fn
  statement_id           = "PublicFunctionUrl"
  action                 = "lambda:InvokeFunctionUrl"
  function_name          = aws_lambda_function.app[0].function_name
  principal              = "*"
  function_url_auth_type = "NONE"
}

resource "aws_lambda_permission" "url_invoke" {
  count                    = local.fn
  statement_id             = "PublicFunctionUrlInvoke"
  action                   = "lambda:InvokeFunction"
  function_name            = aws_lambda_function.app[0].function_name
  principal                = "*"
  invoked_via_function_url = true
}

# ---------------------------------------------------------------- GitHub sync schedule

# A frozen function can't wake itself, so EventBridge invokes it every sync_minutes. The Lambda
# Web Adapter posts this event to /events, which checks GitHub and re-embeds changed repos.
resource "aws_cloudwatch_event_rule" "sync" {
  count               = var.create_function && var.sync_minutes > 0 ? 1 : 0
  name                = "${var.name}-github-sync"
  description         = "Keep the FitCheck index in step with GitHub"
  schedule_expression = "rate(${var.sync_minutes} minutes)"
}

resource "aws_cloudwatch_event_target" "sync" {
  count = length(aws_cloudwatch_event_rule.sync)
  rule  = aws_cloudwatch_event_rule.sync[0].name
  arn   = aws_lambda_function.app[0].arn
  input = jsonencode({ action = "sync", token = random_password.sync_token.result })
}

resource "aws_lambda_permission" "sync" {
  count         = length(aws_cloudwatch_event_rule.sync)
  statement_id  = "AllowGitHubSyncSchedule"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.app[0].function_name
  principal     = "events.amazonaws.com"
  source_arn    = aws_cloudwatch_event_rule.sync[0].arn
}

# A failed scheduled sync isn't retried: the next one is minutes away.
resource "aws_lambda_function_event_invoke_config" "app" {
  count                        = local.fn
  function_name                = aws_lambda_function.app[0].function_name
  maximum_retry_attempts       = 0
  maximum_event_age_in_seconds = 600
}

# ---------------------------------------------------------------- cost guard

# A whole-account monthly budget with an email at 80%.
resource "aws_budgets_budget" "monthly" {
  count        = var.budget_email == "" ? 0 : 1
  name         = "${var.name}-monthly"
  budget_type  = "COST"
  limit_amount = tostring(var.budget_usd)
  limit_unit   = "USD"
  time_unit    = "MONTHLY"

  notification {
    comparison_operator        = "GREATER_THAN"
    threshold                  = 80
    threshold_type             = "PERCENTAGE"
    notification_type          = "ACTUAL"
    subscriber_email_addresses = [var.budget_email]
  }
}
