# "live" calls the real APIs; "fake" runs fully offline (no keys, no network).
PROVIDER_MODE=live

# --- NVIDIA API (free): JD parsing + embeddings ------------------------------------
# Get a key at https://build.nvidia.com. Never commit it.
NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
CHAT_THINKING=false
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_INPUT_TYPE=true

# --- Fit scoring ---------------------------------------------------------------------
# llm_json  = NVIDIA chat model judges fit (free, confidence not calibrated) - the default
# system_one = Mercury Decide on OpenRouter (calibrated confidence; needs OpenRouter credits,
#              ~$0.02 per million input tokens, i.e. ~Rs 0.03 per check)
# parallel   = Parallel Decisions on OpenRouter (free). It always searches the web (that
#              can't be turned off): its web sources are dropped, only retrieved code can be
#              cited, and the candidate's name is replaced before anything is sent.
SCORER=llm_json
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# If OpenRouter says the credits (or the free daily quota) ran out, score with this free
# scorer instead and say so in the report. Empty = no fallback (nothing is claimed).
SCORER_FALLBACK=llm_json
CREDIT_PAUSE_MINUTES=15
DECIDE_MODEL=inception/mercury-decide
PARALLEL_MODEL=parallel/decisions-fast:free

# --- Vector store ------------------------------------------------------------------
# "memory" = JSON file (local dev), "pgvector" = PostgreSQL + pgvector (deployment)
VECTOR_STORE=memory
INDEX_PATH=data/index.json
# Evals only, never served: includes projects that aren't public (scripts.ingest --eval ...)
EVAL_INDEX_PATH=data/eval-index.json
DATABASE_URL=postgresql://fitcheck:fitcheck@localhost:5432/fitcheck

# --- Behaviour ---------------------------------------------------------------------
RETRIEVE_TOP_K=5
# vector (default) or hybrid = vector top k + up to KEYWORD_EXTRA chunks only keyword (BM25) search found (opt-in, PROJECT.md §9)
RETRIEVAL=vector
KEYWORD_EXTRA=3
MIN_CONFIDENCE=0.5
MAX_JD_CHARS=12000
MAX_REQUIREMENTS=15

# --- Public demo guards ------------------------------------------------------------
RATE_LIMIT_PER_HOUR=20
# All visitors together, per UTC day (0 = off). Protects the free model quotas from rotating IPs.
DAILY_LIMIT=200
# Only set true behind a proxy you trust (Render/Fly set X-Forwarded-For).
TRUST_PROXY_HEADERS=false
# How many proxies append to X-Forwarded-For. The visitor is read from the right, so a forged
# left-hand entry is ignored.
PROXY_HOPS=1

# --- Report ------------------------------------------------------------------------
CANDIDATE_NAME=Arshdeep Singh
# Citations become links: {GITHUB_BASE_URL}/{repo}/blob/{GITHUB_BRANCH}/{path}#L{start}-L{end}
GITHUB_BASE_URL=https://github.com/arshdeep3010
GITHUB_BRANCH=main

# --- GitHub sync (python -m scripts.ingest --github USER) ----------------------------
GITHUB_USER=arshdeep3010
# Optional: a fine-grained token with no extra permissions raises the API limit.
GITHUB_TOKEN=
# Repo names to skip, comma-separated
GITHUB_EXCLUDE=
# Live sync: the running app checks GitHub at startup and every N minutes (0 = off).
# Only repos with a new commit are re-embedded. Needs PROVIDER_MODE=live and GITHUB_USER.
GITHUB_SYNC_INTERVAL_MIN=30
# Optional: POST /api/sync with "Authorization: Bearer <token>" forces a check now. Empty = off.
SYNC_TOKEN=

# --- Self-reported profile (CV) --------------------------------------------------------
# Re-indexed by the live sync whenever the file changes
PROFILE_PATH=profile/profile.md
CV_TOP_K=3
# Optional link shown on "Stated on CV" rows, e.g. a public PDF of the CV
CV_URL=
